# Variables consumed by docker-compose.yml. Copy to `.env` (next to docker-compose.yml).
# Safe development defaults are baked into the compose file; override what you need here.

# Groq API key for column classification + AI insights (leave empty to exercise the fallback paths)
AI_API_KEY=

# Secrets shared between services — CHANGE THESE outside local development
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_KEY=dev-internal-api-key-change-me
N8N_WEBHOOK_SECRET=dev-webhook-secret-change-me
N8N_ENCRYPTION_KEY=dev-n8n-encryption-key-change-me

# Host ports (change if something on your machine already uses them)
API_PORT=5000
MONGO_PORT=27018
REDIS_PORT=6379
KAFKA_PORT=9092
N8N_PORT=5678
MAILPIT_UI_PORT=8025
KAFKA_UI_PORT=8080

# Timezone for n8n schedules (e.g. Asia/Kolkata, Europe/London)
GENERIC_TIMEZONE=UTC

# Where n8n reaches the API. Default: the `api` container. When the API runs on the host
# (docs/LOCAL_SETUP.md option B) use http://host.docker.internal:5000
# N8N_VIZINTEL_API_URL=http://host.docker.internal:5000
