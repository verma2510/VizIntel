# ---------------------------------------------------------------------------------------------------
# VizIntel backend configuration. Copy to `.env` and fill in values.
# Only MONGO_URI and JWT_SECRET are required. Everything below the "Optional integrations" line is
# switched on by setting it — leave it blank and the API runs exactly as before (single process).
# ---------------------------------------------------------------------------------------------------

# --- Required ---
MONGO_URI=mongodb://localhost:27017/vizintel
JWT_SECRET=change-me
PORT=5000

# --- AI (Groq, OpenAI-compatible) ---
AI_API_KEY=
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=openai/gpt-oss-20b
# AI_TIMEOUT_MS=30000

# --- Runtime ---
# NODE_ENV=development
# LOG_LEVEL=debug
# CORS_ORIGIN=http://localhost:5173          # comma-separated; empty = allow all (previous behaviour)
# TRUST_PROXY=1                              # set behind Render / NGINX / a load balancer
# APP_URL=http://localhost:5173              # used for links in notification emails
# UPLOAD_MAX_FILE_MB=15
# MONGO_MAX_POOL_SIZE=20

# ===================================== Optional integrations =========================================

# --- Kafka (event pipeline). Unset => events are processed in-process ("inline" mode) ---
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_PREFIX=vizintel
# KAFKA_CLIENT_ID=vizintel
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=                      # plain | scram-sha-256 | scram-sha-512 (managed Kafka)
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_REPLICATION_FACTOR=1                 # 3 in production clusters
# KAFKA_ACTIVITY_PARTITIONS=6

# --- Insight generation: sync (inside the upload request) | async (background worker).
# Defaults to async when Kafka is enabled, sync otherwise.
# INSIGHTS_MODE=sync
# INSIGHTS_STALE_MINUTES=10
# INSIGHTS_MAX_ATTEMPTS=5

# --- Redis (cache + distributed rate limiting). Unset => bypassed ---
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_DATASET_LIST=120
# CACHE_TTL_DATASET=600
# CACHE_TTL_SUMMARY=60
# CACHE_TTL_ANALYTICS=300
# CACHE_TTL_ACTIVITY=30
# CACHE_TTL_COLUMN_CLASSIFICATION=604800
# RATE_LIMIT_AUTH_PER_MIN=30
# RATE_LIMIT_UPLOADS_PER_MIN=10
# RATE_LIMIT_EVENTS_PER_MIN=240

# --- n8n automation ---
# N8N_WEBHOOK_DATASET_UPLOADED=http://localhost:5678/webhook/vizintel/dataset-uploaded
# N8N_WEBHOOK_INSIGHTS_GENERATED=http://localhost:5678/webhook/vizintel/insights-generated
# N8N_WEBHOOK_SECRET=                        # HMAC secret shared with n8n (must match n8n's env)
# INTERNAL_API_KEY=                          # key n8n uses to call /api/internal/*

# --- Workers ---
# WORKER_HEALTH_PORT=0                       # e.g. 9100 to expose GET / health JSON
# WORKER_MAX_ATTEMPTS=5
