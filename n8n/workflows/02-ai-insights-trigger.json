{
  "id": "vzInsightsTrigr1",
  "name": "VizIntel - AI Insight Generation Trigger",
  "versionId": "b18c4ebf-d999-41a5-ab5a-3cb5adac5184",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "7b09febd-6c56-4ba3-a9a8-0015caff32b3",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "eab4e9c2-bb9a-4cb5-aba6-6bb56b341ea8",
      "name": "Run Sweep Now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.VIZINTEL_API_URL }}/api/internal/insights/backlog?limit=25",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.VIZINTEL_INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "d45c794b-e611-48ba-afb3-650ae7dc70c5",
      "name": "Fetch Insight Backlog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// One item per dataset whose insights failed or have been pending too long.\n// An empty backlog returns no items, so the rest of the workflow is skipped.\nconst backlog = $input.first().json;\nreturn (backlog.items || []).map((d) => ({ json: d }));"
      },
      "id": "07abcf9d-fe7e-4eb5-a50f-4bdb6a043515",
      "name": "Split Backlog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIZINTEL_API_URL }}/api/internal/datasets/{{ $json.datasetId }}/insights",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.VIZINTEL_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reason: \"n8n:sweeper\" }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "318bad31-cb39-456b-a101-fda8243254e2",
      "name": "Request Regeneration (sweep)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map((i) => i.json);\nreturn [{ json: {\n  requested: results.length,\n  deduplicated: results.filter((r) => r.deduplicated).length,\n  datasetIds: results.map((r) => r.datasetId),\n  ranAt: new Date().toISOString(),\n} }];"
      },
      "id": "c3af7cf4-3756-4ea6-a4fa-b42298f08606",
      "name": "Summarize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vizintel/insights/regenerate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c2b9ac3d-21d1-4af9-af20-d2dfe423c382",
      "name": "Regenerate On Demand",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        500
      ],
      "webhookId": "d2dcee92-2eee-49e4-ab3a-255268960259"
    },
    {
      "parameters": {
        "jsCode": "// On-demand trigger for other systems (e.g. a Slack command or support tooling).\n// Requires the same internal API key the backend uses, sent as X-Internal-Api-Key.\nconst crypto = require('crypto');\nconst digest = (v) => crypto.createHash('sha256').update(String(v || '')).digest();\nreturn $input.all().map((item) => {\n  const provided = (item.json.headers || {})['x-internal-api-key'];\n  const expected = $env.VIZINTEL_INTERNAL_API_KEY;\n  const authorized = Boolean(expected) && crypto.timingSafeEqual(digest(provided), digest(expected));\n  const datasetId = String((item.json.body || {}).datasetId || '');\n  const valid = authorized && /^[a-f0-9]{24}$/i.test(datasetId);\n  return { json: { valid, datasetId, reason: !authorized ? 'unauthorized' : valid ? null : 'datasetId must be a 24-char ObjectId' } };\n});"
      },
      "id": "416e8b23-4884-4620-ae68-6c119c26ccc4",
      "name": "Authorize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b6fc3b0e-7e1a-4eef-a689-a0c2ec191b71",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5b3a56c5-bf15-4308-a0f7-d17ff3873d3b",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIZINTEL_API_URL }}/api/internal/datasets/{{ $json.datasetId }}/insights",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.VIZINTEL_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reason: \"n8n:on-demand\" }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "f7dbbf69-be07-42fe-a80d-12f71018cbbc",
      "name": "Request Regeneration (on demand)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        420
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "cb35a346-2856-485c-a157-9cd4a6119be5",
      "name": "Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: false, reason: $json.reason }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "88f93202-72e1-4ea5-a76d-6e50a40920d1",
      "name": "Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        600
      ]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Insight Backlog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Sweep Now": {
      "main": [
        [
          {
            "node": "Fetch Insight Backlog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Insight Backlog": {
      "main": [
        [
          {
            "node": "Split Backlog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Backlog": {
      "main": [
        [
          {
            "node": "Request Regeneration (sweep)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Regeneration (sweep)": {
      "main": [
        [
          {
            "node": "Summarize Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Regenerate On Demand": {
      "main": [
        [
          {
            "node": "Authorize Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorize Request": {
      "main": [
        [
          {
            "node": "Authorized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorized?": {
      "main": [
        [
          {
            "node": "Request Regeneration (on demand)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Regeneration (on demand)": {
      "main": [
        [
          {
            "node": "Accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "UTC"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
